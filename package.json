{
  "name": "cafe-project-system",
  "private": true,
  "scripts": {
    "test": "node scripts/ci/run-external-tests.cjs normal",
    "test:mock": "node scripts/ci/run-external-tests.cjs mock",
    "test:smoke": "node scripts/ci/run-regression.cjs smoke",
    "test:core": "node scripts/ci/run-regression.cjs core",
    "test:module": "node scripts/ci/run-regression.cjs module",
    "test:full": "node scripts/ci/run-regression.cjs full",
    "test:security": "node scripts/ci/run-regression.cjs security",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:seed": "npm run seed -w @cafe-project/database"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.0.0",
    "playwright": "^1.61.1",
    "prettier": "^3.7.4",
    "prisma": "^6.19.3",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@prisma/config@6.19.3": {
      "deepmerge-ts": "8.0.2",
      "effect": "3.22.5"
    }
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "node-cron": "4.4.1",
    "nodemailer": "10.6.1"
  }
}
