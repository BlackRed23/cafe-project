{
  "name": "cafe-project-system",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:seed": "npm run seed -w @cafe-project/database"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "prisma": "^6.19.3",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "node-cron": "4.4.1",
    "nodemailer": "9.0.1"
  }
}
