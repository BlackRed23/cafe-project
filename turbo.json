{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": ["LLM_PROVIDER", "LLM_API_KEY", "LLM_BASE_URL", "LLM_MODEL", "LLM_TIMEOUT_MS", "LLM_STRUCTURED_OUTPUT"],
      "outputs": [
        "dist/**"
      ]
    },
    "@cafe-project/web#build": {
      "dependsOn": ["^build"],
      "env": ["VITE_*"],
      "outputs": ["dist/**"]
    },
    "generate": {
      "cache": false
    },
    "@cafe-project/database#build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"]
    },
    "@cafe-project/database#check-types": {
      "dependsOn": ["^build", "generate"],
      "outputs": []
    },
    "@cafe-project/types#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check-types": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    }
  }
}
