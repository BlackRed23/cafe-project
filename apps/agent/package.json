{
    "name": "@cafe-project/agent",
    "version": "1.0.0",
    "private": true,
    "main": "dist/public-api.js",
    "types": "dist/public-api.d.ts",
    "exports": {
        ".": "./dist/public-api.js"
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "dev:server": "tsx src/server.ts",
        "dev:worker": "tsx src/worker.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "start:server": "node dist/server.js",
        "start:worker": "node dist/worker.js",
        "scan": "tsx src/worker.ts --scan-once"
    },
    "dependencies": {
        "@cafe-project/database": "*",
        "@google/generative-ai": "^0.24.1",
        "dotenv": "^16.4.5",
        "node-cron": "^4.4.1",
        "nodemailer": "9.0.1"
    },
    "devDependencies": {
        "@types/node": "^20.12.11",
        "@types/node-cron": "^3.0.11",
        "tsx": "^4.19.2",
        "typescript": "^5.4.5"
    }
}
