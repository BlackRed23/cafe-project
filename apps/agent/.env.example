DATABASE_URL="postgresql://postgres:123456@localhost:5433/cafe_project?schema=public"
DATA_PROVIDER="postgres"
AGENT_HOST="127.0.0.1"
AGENT_PORT="5055"
# Shared 64+ char internal secret matching apps/api/.env AGENT_INTERNAL_TOKEN
AGENT_INTERNAL_TOKEN=""

# Recommendation mode: "gemini" (with deterministic rule-based fallback) or "rule-based"
AGENT_RECOMMENDATION_MODE="gemini"
# Provide your Google Gemini API key here to enable live LLM recommendations; leave blank to use deterministic fallback
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TIMEOUT_MS="10000"

RUN_ON_START="false"
DEBUG_MODE="false"
AGENT_SCAN_CRON="*/10 * * * *"
