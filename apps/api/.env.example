PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cafe_project?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
FRONTEND_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# Gmail SMTP example. Use your email as SMTP_USER and an app password as SMTP_PASS.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="Cafe INV <your-email@gmail.com>"
