PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cafe_project?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
FRONTEND_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# Gmail SMTP example. Use your email as SMTP_USER and an app password as SMTP_PASS.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="Cafe INV <your-email@gmail.com>"

# Payment Gateways (MoMo Sandbox & VNPay Sandbox)
# LƯU Ý: Để nhận IPN/Webhook từ MoMo hoặc VNPay khi chạy local, hãy mở tunnel:
#   ngrok http 5000   HOẶC   cloudflared tunnel --url http://localhost:5000
# rồi đặt API_BASE_URL="https://<your-tunnel-domain>"
# Với VNPay Sandbox: vào trang quản trị merchant sandbox cấu hình IPN URL:
#   https://<your-tunnel-domain>/api/payments/webhook/vnpay-ipn
# Thẻ test VNPay Sandbox (Ngân hàng NCB):
#   Số thẻ: 9704198526191432198 | Chủ thẻ: NGUYEN VAN A | Ngày phát hành: 07/15 | OTP: 123456
API_BASE_URL="https://xxxx.ngrok-free.app"
CLIENT_URL="http://localhost:5173"

MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""
MOMO_ENDPOINT="https://test-payment.momo.vn/v2/gateway/api/create"

VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="http://localhost:5173/payment/result"

# Cron hết hạn giao dịch online & tự động hủy đơn online quá hạn (nhả giữ kho)
ENABLE_PAYMENT_EXPIRE_CRON=true
PAYMENT_EXPIRE_CRON_SCHEDULE="*/5 * * * *"
ENABLE_UNPAID_ORDER_AUTO_CANCEL=true
UNPAID_ONLINE_ORDER_CANCEL_MINUTES=120
