enum OrderStatus {
  PENDING
  PROCESSING
  PREPARING
  COMPLETED
  CANCELLED
}

enum ConsumptionStatus {
  PENDING
  COMMITTED
  VOIDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  VIET_QR
  MOMO
  VNPAY
}

enum TransactionStatus {
  INITIATED
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum CallbackStatus {
  RECEIVED
  VERIFIED
  APPLIED
  DUPLICATED
  REJECTED_INVALID_SIGNATURE
  FAILED
}

enum PaymentRefundStatus {
  REQUESTED
  PROCESSING
  UNKNOWN
  SUCCEEDED
  FAILED
}

model Order {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  status          OrderStatus    @default(PENDING)
  totalAmount     Decimal        @default(0) @db.Decimal(12, 2)
  shippingFee     Decimal        @default(0) @db.Decimal(12, 2)
  shippingZone    String?
  shippingName    String?
  shippingPhone   String?
  shippingAddress String?
  note            String?
  stockDeductedAt DateTime?
  paymentMethod   PaymentMethod?
  paymentStatus   PaymentStatus  @default(PENDING)
  paidAt          DateTime?
  version         Int            @default(0)
  adjustmentTotal Decimal        @default(0) @db.Decimal(12, 2)
  operations      OrderOperation[]

  items    OrderItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id                String            @id @default(cuid())
  orderId           String
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product           @relation(fields: [productId], references: [id])
  recipeId          String?
  recipe            Recipe?           @relation(fields: [recipeId], references: [id])
  recipeVersion     Int?
  quantity          Int
  price             Decimal           @db.Decimal(12, 2)
  consumptionStatus ConsumptionStatus @default(PENDING)
  startedAt         DateTime?
  committedAt       DateTime?
  voidedAt          DateTime?
  originalItemId    String?
  attemptType       String            @default("SALE")
  replacedAt        DateTime?
  ingredientCost    Decimal           @default(0) @db.Decimal(12, 2)
  toppingCost       Decimal           @default(0) @db.Decimal(12, 2)
  totalCost         Decimal           @default(0) @db.Decimal(12, 2)
  grossProfit       Decimal           @default(0) @db.Decimal(12, 2)

  toppings OrderItemTopping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId, productId])
}

model OrderOperation {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id])
  requestId         String
  requestHash       String
  kind              String
  status            String   @default("REQUESTED")
  actorId           String
  approvedBy        String?
  reason            String
  originalItemId    String?
  replacementItemId String?
  payload           Json
  amountDelta       Decimal  @default(0) @db.Decimal(12, 2)
  createdAt         DateTime @default(now())
  approvedAt        DateTime?

  @@unique([orderId, requestId])
  @@index([orderId, createdAt])
}

model OrderItemTopping {
  id           String    @id @default(cuid())
  orderItemId  String
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  toppingId    String
  topping      Topping   @relation(fields: [toppingId], references: [id])
  quantity     Int       @default(1)
  price        Decimal   @default(0) @db.Decimal(12, 2)
  costSnapshot Decimal   @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([orderItemId])
}

model Payment {
  id              String            @id @default(cuid())
  orderId         String
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method          PaymentMethod
  providerTxnId   String?           @unique
  merchantRef     String?
  amount          Decimal           @db.Decimal(12, 2)
  currency        String            @default("VND")
  status          TransactionStatus @default(INITIATED)
  attemptNo       Int               @default(1)
  requestPayload  Json?
  responsePayload Json?
  failureCode     String?
  failureMessage  String?
  paidAt          DateTime?
  expiresAt       DateTime?

  callbacks PaymentCallback[]
  refunds   PaymentRefund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

model PaymentCallback {
  id              String         @id @default(cuid())
  method          PaymentMethod
  providerEventId String?        @unique
  eventType       String?
  paymentId       String?
  payment         Payment?       @relation(fields: [paymentId], references: [id])
  signatureValid  Boolean        @default(false)
  rawPayload      Json
  headers         Json?
  receivedAt      DateTime       @default(now())
  processedAt     DateTime?
  status          CallbackStatus @default(RECEIVED)
  errorMessage    String?
  retryCount      Int            @default(0)
}

model PaymentReconciliation {
  id             String        @id @default(cuid())
  method         PaymentMethod
  businessDate   DateTime
  expectedCount  Int           @default(0)
  expectedAmount Decimal       @default(0) @db.Decimal(14, 2)
  actualCount    Int           @default(0)
  actualAmount   Decimal       @default(0) @db.Decimal(14, 2)
  matchedCount   Int           @default(0)
  missingCount   Int           @default(0)
  orphanCount    Int           @default(0)
  resolvedAt     DateTime?
  resolvedBy     String?
  note           String?

  createdAt DateTime @default(now())

  @@unique([method, businessDate])
}

model PaymentRefund {
  id               String              @id @default(cuid())
  paymentId        String
  payment          Payment             @relation(fields: [paymentId], references: [id])
  requestId        String
  requestHash      String
  amount           Decimal             @db.Decimal(12, 2)
  status           PaymentRefundStatus @default(REQUESTED)
  reason           String
  approvalRef      String
  policyVersion    String
  requestedBy      String
  providerRefundId String?
  providerCode     String?
  failureMessage   String?
  attemptCount     Int                 @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  events           PaymentRefundEvent[]

  @@unique([paymentId, requestId])
  @@index([paymentId, status])
}

model PaymentRefundEvent {
  id          String              @id @default(cuid())
  refundId    String
  refund      PaymentRefund       @relation(fields: [refundId], references: [id])
  status      PaymentRefundStatus
  kind        String
  actorId     String?
  providerRef String?
  detail      Json?
  createdAt   DateTime            @default(now())

  @@index([refundId, createdAt])
}
