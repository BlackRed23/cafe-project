model AgentLog {
  id             String   @id @default(uuid())
  action         String
  input          String?
  output         String?
  reasoning      String?
  fallback_used  Boolean  @default(false)
  error_message  String?
  reference_type String?
  reference_id   String?
  result         String?
  triggered_at   DateTime @default(now())
  createdBy      String?
  creator        User?    @relation("AgentLogCreatedBy", fields: [createdBy], references: [id])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
