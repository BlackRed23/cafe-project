model Supplier {
  id               String    @id @default(cuid())
  name             String
  email            String?
  contact          String?
  address          String?
  status           String    @default("ACTIVE")
  deletedAt        DateTime?
  // Unknown historical score stays NULL; DOCX specifies no scoring formula/range.
  reliabilityScore Decimal?  @db.Decimal

  ingredients      SupplierIngredient[]
  purchaseRequests PurchaseRequest[]
  batches          IngredientBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupplierIngredient {
  id                   String     @id @default(cuid())
  supplierId           String
  supplier             Supplier   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  ingredientId         String
  ingredient           Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  pricePerBaseUnit     Decimal    @db.Decimal(18, 4)
  supplierSku          String?
  purchaseUnit         String
  conversionQuantity   Decimal    @db.Decimal(14, 3)
  conversionTargetUnit String     @default("g")
  minOrderQuantity     Int        @default(1)
  leadTimeDays         Int        @default(3)
  isPreferred          Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([supplierId, ingredientId])
}
