enum ToppingType {
  ADD
  REMOVE
  SUBSTITUTE
}

model Product {
  id                 String    @id @default(cuid())
  name               String
  sku                String    @unique
  description        String?
  price              Decimal   @default(0) @db.Decimal(12, 2)
  costPrice          Decimal   @default(0) @db.Decimal(65, 30)
  servingUnit        String    @default("ly")
  imageUrl           String?
  isActive           Boolean   @default(true)
  deletedAt          DateTime?
  pendingDeleteUntil DateTime?

  nutritionFacts      String?
  usageInstructions   String?
  storageInstructions String?
  origin              String?
  certifications      String?
  expiryInfo          String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  recipes    Recipe[]
  orderItems OrderItem[]
  toppings   Topping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Recipe {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  version       Int       @default(1)
  isActive      Boolean   @default(true)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  yieldQuantity Decimal   @default(1.0) @db.Decimal(10, 2)
  laborCost     Decimal   @default(0) @db.Decimal(12, 2)
  overheadCost  Decimal   @default(0) @db.Decimal(12, 2)
  note          String?

  ingredients RecipeIngredient[]
  orderItems  OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, version])
  @@unique([id, productId, version])
  @@index([productId, isActive])
}

model RecipeIngredient {
  id              String     @id @default(cuid())
  recipeId        String
  recipe          Recipe     @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  ingredientId    String
  ingredient      Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity        Decimal    @db.Decimal(14, 3)
  unit            String
  quantityBase    Decimal    @db.Decimal(14, 3)
  isOptional      Boolean    @default(false)
  allowSubstitute Boolean    @default(false)
  note            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recipeId, ingredientId])
}

model Topping {
  id          String      @id @default(cuid())
  name        String      @unique
  toppingType ToppingType @default(ADD)
  price       Decimal     @default(0) @db.Decimal(12, 2)
  productId   String?
  product     Product?    @relation(fields: [productId], references: [id], onDelete: Restrict)
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)

  ingredients ToppingIngredient[]
  orderItems  OrderItemTopping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ToppingIngredient {
  id           String     @id @default(cuid())
  toppingId    String
  topping      Topping    @relation(fields: [toppingId], references: [id], onDelete: Restrict)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantityBase Decimal    @db.Decimal(14, 3)
  note         String?

  createdAt DateTime @default(now())

  @@unique([toppingId, ingredientId])
}
