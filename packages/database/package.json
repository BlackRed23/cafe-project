{
    "name": "@cafe-project/database",
    "version": "1.0.0",
    "private": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "check-types": "tsc --noEmit",
        "bootstrap:test-accounts": "tsx scripts/bootstrap-test-accounts-cli.ts",
        "test:bootstrap": "node --test tests/bootstrap-test-accounts.test.cjs",
        "check:bootstrap": "tsc --noEmit --strict --esModuleInterop --skipLibCheck --target ES2020 --module commonjs scripts/bootstrap-test-accounts.ts scripts/bootstrap-test-accounts-cli.ts",
        "build": "tsc",
        "generate": "prisma generate",
        "db:push": "prisma db push",
        "seed": "tsx prisma/seed_cafe.ts",
        "fetch-images": "tsx prisma/fetch-pexels-images.ts",
        "prebuild": "npm run generate"
    },
    "dependencies": {
        "@prisma/client": "^6.19.3",
        "bcrypt": "^6.0.0"
    },
    "devDependencies": {
        "prisma": "^6.19.3",
        "tsx": "^4.22.4",
        "typescript": "^5.0.0"
    },
    "prisma": {
        "schema": "prisma/schema",
        "seed": "tsx prisma/seed_cafe.ts"
    }
}
