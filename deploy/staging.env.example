# Copy to /opt/cafe/staging/.env ON THE STAGING SERVER ONLY.
# Never commit the real .env or use the shared cafedb for E2E fixtures.
# The deploy script refuses to run without an explicit DB readiness approval.
STAGING_DB_READY=NO
DATABASE_URL=postgresql://STAGING_DB_USER:CHANGE_ME@STAGING_DB_HOST:5432/CHANGE_ME?schema=public
JWT_SECRET=CHANGE_ME_TO_RANDOM_SECRET
AGENT_INTERNAL_TOKEN=CHANGE_ME_TO_RANDOM_SECRET
CORS_ORIGIN=https://staging.example.invalid
FRONTEND_URL=https://staging.example.invalid
VITE_API_URL=https://staging.example.invalid/api
AGENT_GRAPH_READONLY=YES
AGENT_GRAPH_PURCHASING=NO
STAGING_GRAPH_READONLY=YES
STAGING_GRAPH_PURCHASING=NO
